#!/usr/bin/python3
"""Keep Steam CEF threads on a device-selected CPU set for one client run."""

import os
import pathlib
import sys
import time


PROC_ROOT = pathlib.Path(os.environ.get("ARMADA_PROC_ROOT", "/proc"))
POLL_SECONDS = float(os.environ.get("ARMADA_STEAM_AFFINITY_POLL_SECONDS", "0.25"))


def parse_cpulist(value):
    cpus = set()
    for part in value.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            low, high = part.split("-", 1)
            low, high = int(low), int(high)
            if high < low:
                raise ValueError("reversed CPU range")
            cpus.update(range(low, high + 1))
        else:
            cpus.add(int(part))
    if not cpus or min(cpus) < 0:
        raise ValueError("empty or negative CPU set")
    return cpus


def status_fields(path):
    fields = {}
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            key, separator, value = line.partition(":")
            if separator:
                fields[key] = value.strip()
    except OSError:
        return {}
    return fields


def process_starttime(proc_root, pid):
    try:
        # Splitting after the final ')' keeps spaces and ')' inside comm safe.
        fields = (proc_root / str(pid) / "stat").read_text(encoding="utf-8").rsplit(")", 1)[1].split()
        return fields[19]  # field 22; this list starts at field 3
    except (OSError, IndexError):
        return None


def process_uid(proc_root, pid):
    fields = status_fields(proc_root / str(pid) / "status")
    try:
        return int(fields["Uid"].split()[0])
    except (KeyError, ValueError, IndexError):
        return None


def normalize_once(proc_root, owner_uid, target, setter=os.sched_setaffinity):
    changed = []
    try:
        entries = sorted(
            proc_root.iterdir(),
            key=lambda path: int(path.name) if path.name.isdigit() else -1,
        )
    except OSError:
        return changed
    for entry in entries:
        if not entry.name.isdigit():
            continue
        fields = status_fields(entry / "status")
        if fields.get("Name") != "steamwebhelper":
            continue
        try:
            uid = int(fields["Uid"].split()[0])
            current = parse_cpulist(fields["Cpus_allowed_list"])
        except (KeyError, ValueError, IndexError):
            continue
        if uid != owner_uid or current == target:
            continue
        try:
            tasks = sorted(
                (entry / "task").iterdir(),
                key=lambda path: int(path.name) if path.name.isdigit() else -1,
            )
        except OSError:
            continue
        updated = False
        for task in tasks:
            if not task.name.isdigit():
                continue
            try:
                setter(int(task.name), target)
                updated = True
            except (OSError, PermissionError):
                continue
        if updated:
            changed.append(int(entry.name))
    return changed


def main(argv):
    if len(argv) != 3:
        print(f"usage: {argv[0]} STEAM_PID CPULIST", file=sys.stderr)
        return 2
    try:
        steam_pid = int(argv[1])
        target = parse_cpulist(argv[2])
    except ValueError as exc:
        print(f"steam-client-affinity: {exc}", file=sys.stderr)
        return 2
    owner_uid = process_uid(PROC_ROOT, steam_pid)
    starttime = process_starttime(PROC_ROOT, steam_pid)
    if owner_uid is None or starttime is None:
        return 1
    while process_starttime(PROC_ROOT, steam_pid) == starttime:
        normalize_once(PROC_ROOT, owner_uid, target)
        time.sleep(POLL_SECONDS)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
