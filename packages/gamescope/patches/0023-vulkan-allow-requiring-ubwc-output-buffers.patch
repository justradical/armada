From: Armada <noreply@armada.local>
Subject: [PATCH] vulkan: allow requiring UBWC output buffers

Qualcomm inline rotation requires compressed scanout buffers.  Allow device
profiles to restrict Gamescope output images to the UBWC modifier without
changing client buffer support.

---
 src/rendervulkan.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/rendervulkan.cpp b/src/rendervulkan.cpp
--- a/src/rendervulkan.cpp
+++ b/src/rendervulkan.cpp
@@ -2167,6 +2167,8 @@ bool CVulkanTexture::BInit( uint32_t width, uint32_t height, uint32_t depth, uin
 	}
 
 	std::vector<uint64_t> modifiers = {};
+	const bool bRequireQcomCompressedOutput = flags.bOutputImage &&
+		env_to_bool( getenv( "GAMESCOPE_DRM_REQUIRE_QCOM_COMPRESSED_OUTPUT" ) );
 	// TODO(JoshA): Move this code to backend for making flippable image.
 	if ( GetBackend()->UsesModifiers() && flags.bFlippable && g_device.supportsModifiers() && !pDMA )
 	{
@@ -2192,6 +2194,8 @@ bool CVulkanTexture::BInit( uint32_t width, uint32_t height, uint32_t depth, uin
 		for ( size_t i = 0; i < numPossibleModifiers; i++ )
 		{
 			uint64_t modifier = possibleModifiers[i];
+			if ( bRequireQcomCompressedOutput && modifier != DRM_FORMAT_MOD_QCOM_COMPRESSED )
+				continue;
 
 			VkExternalImageFormatProperties externalFormatProps = {
 				.sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES,
-- 
