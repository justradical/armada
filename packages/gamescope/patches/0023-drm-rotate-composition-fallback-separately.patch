From: Armada <noreply@armada.local>
Subject: [PATCH] drm: rotate composition fallback separately

Some display engines can rotate compatible client buffers directly but
cannot rotate Gamescope's linear composition buffers.  Allow device profiles
to keep direct scanout rotation while rendering fallback composition in the
panel's physical orientation.

Disable partial composition in this mode because it would mix output-oriented
and scanout-rotated planes.

---
 src/Backends/DRMBackend.cpp | 16 +++++++++++++---
 src/main.cpp                |  1 +
 src/main.hpp                |  1 +
 src/rendervulkan.cpp        |  4 ++--
 src/steamcompmgr.cpp        |  4 ++--
 5 files changed, 19 insertions(+), 7 deletions(-)

diff --git a/src/Backends/DRMBackend.cpp b/src/Backends/DRMBackend.cpp
--- a/src/Backends/DRMBackend.cpp
+++ b/src/Backends/DRMBackend.cpp
@@ -2611,7 +2611,9 @@ LiftoffStateCacheEntry FrameInfoToLiftoffStateCacheEntry( struct drm_t *drm, con
 		uint64_t crtcW = srcWidth / frameInfo->layers.get( i ).scale.x;
 		uint64_t crtcH = srcHeight / frameInfo->layers.get( i ).scale.y;
 
-		if (g_bRotated && g_uOutputRotation == 0)
+		const bool bCompositeOutputRotated = frameInfo->layers.get( i ).tex->outputImage() &&
+			g_uCompositeOutputRotation != 0;
+		if (g_bRotated && g_uOutputRotation == 0 && !bCompositeOutputRotated)
 		{
 			int64_t imageH = frameInfo->layers.get( i ).tex->contentHeight() / frameInfo->layers.get( i ).scale.y;
 
@@ -3434,7 +3436,9 @@ drm_prepare_liftoff( struct drm_t *drm, const struct FrameInfo_t *frameInfo, boo
 			liftoff_layer_set_property( drm->lo_layers[ i ], "SRC_H", entry.layerState[i].srcH );
 
 			uint64_t ulOrientation = DRM_MODE_ROTATE_0;
-			switch ( g_uOutputRotation != 0 ? GAMESCOPE_PANEL_ORIENTATION_0 : drm->pConnector->GetCurrentOrientation() )
+			const bool bCompositeOutputRotated = frameInfo->layers.get( i ).tex->outputImage() &&
+				g_uCompositeOutputRotation != 0;
+			switch ( g_uOutputRotation != 0 || bCompositeOutputRotated ? GAMESCOPE_PANEL_ORIENTATION_0 : drm->pConnector->GetCurrentOrientation() )
 			{
 			default:
 			case GAMESCOPE_PANEL_ORIENTATION_0:
@@ -4198,6 +4202,7 @@ static void drm_unset_mode( struct drm_t *drm )
 
 	g_bRotated = false;
 	g_uOutputRotation = 0;
+	g_uCompositeOutputRotation = 0;
 }
 
 // Bitmask of DRM_MODE_ROTATE_* the plane can do at scanout (just ROTATE_0 if it can't rotate).
@@ -4273,11 +4278,14 @@ bool drm_set_mode( struct drm_t *drm, const drmModeModeInfo *mode )
 
 	// Rotate in the compositor when the scanout plane can't do the panel's orientation.
 	g_uOutputRotation = 0;
+	g_uCompositeOutputRotation = 0;
 	if ( uStep )
 	{
 		const bool bScanoutCanRotate = drm->pPrimaryPlane && ( drm_plane_supported_rotations( drm, drm->pPrimaryPlane ) & ulNeeded );
 		if ( g_bForceCompositionRotation || !bScanoutCanRotate )
-			g_uOutputRotation = uStep;
+			g_uOutputRotation = g_uCompositeOutputRotation = uStep;
+		else if ( env_to_bool( getenv( "GAMESCOPE_DRM_FALLBACK_COMPOSITION_ROTATION" ) ) )
+			g_uCompositeOutputRotation = uStep;
 	}
 
 	return true;
@@ -4644,6 +4652,8 @@ namespace gamescope
 
 			bNeedsFullComposite |= !!(g_uCompositeDebug & CompositeDebugFlag::Heatmap);
 			bNeedsFullComposite |= g_uOutputRotation != 0; // can't rotate planes at scanout
+			bNeedsFullComposite |= bWantsPartialComposite &&
+				g_uCompositeOutputRotation != g_uOutputRotation;
 			// SDR color work that neither a plane nor the CRTC carries has to go through the shader.
 			if ( !SupportsColorManagement() && !pFrameInfo->outputLuts &&
 			     pFrameInfo->shaperLut[EOTF_Gamma22] )
diff --git a/src/main.cpp b/src/main.cpp
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -400,6 +400,7 @@ static gamescope::GamescopeModeGeneration parse_gamescope_mode_generation( const
 
 bool g_bForceCompositionRotation = false;
 uint32_t g_uOutputRotation = 0;
+uint32_t g_uCompositeOutputRotation = 0;
 
 GamescopePanelOrientation g_DesiredInternalOrientation = GAMESCOPE_PANEL_ORIENTATION_AUTO;
 static GamescopePanelOrientation force_orientation(const char *str)
diff --git a/src/main.hpp b/src/main.hpp
--- a/src/main.hpp
+++ b/src/main.hpp
@@ -26,6 +26,7 @@ extern bool g_bForceInternal;
 
 extern bool g_bForceCompositionRotation;
 extern uint32_t g_uOutputRotation;
+extern uint32_t g_uCompositeOutputRotation;
 
 extern bool g_bFullscreen;
 
diff --git a/src/rendervulkan.cpp b/src/rendervulkan.cpp
--- a/src/rendervulkan.cpp
+++ b/src/rendervulkan.cpp
@@ -3338,7 +3338,7 @@ static bool vulkan_make_output_images( VulkanOutput_t *pOutput )
 	// Output images are physical-oriented; the panel scans out unrotated.
 	uint32_t uOutputWidth = g_nOutputWidth;
 	uint32_t uOutputHeight = g_nOutputHeight;
-	if ( g_uOutputRotation & 1u )
+	if ( g_uCompositeOutputRotation & 1u )
 		std::swap( uOutputWidth, uOutputHeight );
 
 	pOutput->outputImages[0] = new CVulkanTexture();
@@ -4100,7 +4100,7 @@ std::optional<uint64_t> vulkan_composite( struct FrameInfo_t *frameInfo, gamesco
 		compositeImage = partial ? g_output.outputImagesPartialOverlay[ g_output.nOutImage ] : g_output.outputImages[ g_output.nOutImage ];
 
 	// Overrides (screenshots, upscale cache) are logical-sized, so never rotated.
-	const uint32_t uOutputRotation = pOutputOverride ? 0u : g_uOutputRotation;
+	const uint32_t uOutputRotation = pOutputOverride ? 0u : g_uCompositeOutputRotation;
 
 	auto cmdBuffer = pInCommandBuffer ? std::move( pInCommandBuffer ) : g_device.commandBuffer();
 
diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -9262,7 +9262,7 @@ steamcompmgr_main(int argc, char **argv)
 		if ( currentOutputWidth != g_nOutputWidth ||
 			 currentOutputHeight != g_nOutputHeight ||
 			 currentOutputRefresh != g_nOutputRefresh ||
-			 currentOutputRotation != g_uOutputRotation ||
+			 currentOutputRotation != g_uCompositeOutputRotation ||
 			 currentHDROutput != g_bOutputHDREnabled ||
 			 currentHDRCapable != bOutputHDRCapable ||
 			 currentHDRForce != g_bForceHDRSupportDebug )
@@ -9314,7 +9314,7 @@ steamcompmgr_main(int argc, char **argv)
 			currentOutputWidth = g_nOutputWidth;
 			currentOutputHeight = g_nOutputHeight;
 			currentOutputRefresh = g_nOutputRefresh;
-			currentOutputRotation = g_uOutputRotation;
+			currentOutputRotation = g_uCompositeOutputRotation;
 			currentHDROutput = g_bOutputHDREnabled;
 			currentHDRCapable = bOutputHDRCapable;
 			currentHDRForce = g_bForceHDRSupportDebug;
-- 
